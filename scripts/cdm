#!/usr/bin/env bash
# scripts/cdm — build & release toolkit for downloadmgr
#
# Reads .release.toml as the single source of truth for versions.
# Handles DEB (host), RPM (Fedora container), and Arch (PKGBUILD) builds.

set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

# ---------- output ----------
if [[ -t 1 ]]; then
    C_RED=$'\e[31m'; C_GRN=$'\e[32m'; C_YLW=$'\e[33m'
    C_BLU=$'\e[34m'; C_DIM=$'\e[2m'; C_RST=$'\e[0m'
else
    C_RED=; C_GRN=; C_YLW=; C_BLU=; C_DIM=; C_RST=
fi
info() { printf '%s==>%s %s\n' "$C_BLU" "$C_RST" "$*"; }
ok()   { printf '%s ok%s %s\n' "$C_GRN" "$C_RST" "$*"; }
warn() { printf '%s  !%s %s\n' "$C_YLW" "$C_RST" "$*" >&2; }
die()  { printf '%serr%s %s\n' "$C_RED" "$C_RST" "$*" >&2; exit 1; }
has()  { command -v "$1" >/dev/null 2>&1; }

# ---------- .release.toml ----------
read_release() {
    local key="$1" default="$2" line
    [[ -f .release.toml ]] || { echo "$default"; return; }
    line="$(grep -E "^[[:space:]]*${key}[[:space:]]*=" .release.toml | head -n1 || true)"
    [[ -n "$line" ]] || { echo "$default"; return; }
    printf '%s' "$line" | sed -E "s/^[^=]+=[[:space:]]*[\"']?([^\"']*)[\"']?.*/\1/"
}

release_channel() { read_release channel rc;   }
release_version() { read_release version 0.1.0; }
release_rc()      { read_release rc 1;         }
release_publish() { read_release publish true; }

compute_versions() {
    local ch v rc
    ch="$(release_channel)"; v="$(release_version)"; rc="$(release_rc)"
    if [[ "$ch" == "rc" ]]; then
        TAG_VERSION="${v}-rc${rc}"
        PKG_VERSION="${v}~rc${rc}"
    else
        TAG_VERSION="$v"
        PKG_VERSION="$v"
    fi
    RELEASE_TAG="v${TAG_VERSION}"
    PACKAGE_FILE="downloadmgr-${TAG_VERSION}-linux"
}

show_version() {
    compute_versions
    printf 'channel:       %s\n' "$(release_channel)"
    printf 'base version:  %s\n' "$(release_version)"
    printf 'rc number:     %s\n' "$(release_rc)"
    printf 'tag version:   %s\n' "$TAG_VERSION"
    printf 'pkg version:   %s\n' "$PKG_VERSION"
    printf 'release tag:   %s\n' "$RELEASE_TAG"
    printf 'file stem:     %s\n' "$PACKAGE_FILE"
    printf 'publish:       %s\n' "$(release_publish)"
}

# ---------- source tarball ----------
make_source_tarball() {
    local version="$1" out="${2:-/tmp/cdm-${version}.tar.gz}"
    local stage; stage="$(mktemp -d)"
    mkdir -p "$stage/cdm-${version}"
    rsync -a \
        --exclude='.git' \
        --exclude='build*' \
        --exclude='_CPack_Packages' \
        --exclude='*.deb' \
        --exclude='*.rpm' \
        --exclude='*.pkg.tar.zst' \
        --exclude='packaging/arch/pkg' \
        --exclude='packaging/arch/src' \
        --exclude='packaging/arch/cdm-*.tar.gz' \
        --exclude='.cache' \
        "$ROOT/" "$stage/cdm-${version}/"
    tar -czf "$out" -C "$stage" "cdm-${version}"
    rm -rf "$stage"
    printf '%s\n' "$out"
}

# ---------- dependencies ----------
show_deps() {
    local kind="${1:-}"
    local f="$ROOT/packaging/deps/${kind}.sh"
    [[ -f "$f" ]] || die "usage: cdm deps deb|rpm|arch"
    printf '# %s build deps\n' "$kind"
    printf '# run: %s\n\n' "${f#$ROOT/}"
    sed -n '/^[^#]/p' "$f"
}

# ---------- DEB ----------
build_deb() {
    compute_versions
    has dpkg-deb || die "install dpkg (Arch: sudo pacman -S dpkg)"
    has dpkg-shlibdeps || warn "dpkg-shlibdeps missing — Depends will be incomplete; install dpkg"

    info "Building DEB (${PKG_VERSION})"
    rm -rf build-deb _CPack_Packages
    find . -maxdepth 1 -name '*.deb' -delete

    cmake -S . -B build-deb \
        -DCMAKE_BUILD_TYPE=Release \
        -DBUILD_TESTING=OFF
    cmake --build build-deb -j"$(nproc)"
    cpack --config build-deb/CPackConfig.cmake -G DEB

    local deb; deb="$(find . -maxdepth 1 -name '*.deb' -print -quit)"
    [[ -n "$deb" ]] || die "DEB was not produced"
    ok "DEB: $deb"
}

verify_deb() {
    local deb; deb="$(find . -maxdepth 1 -name '*.deb' -print -quit)"
    [[ -n "$deb" ]] || die "no .deb found"
    info "Control: $deb"
    dpkg-deb -f "$deb"
    printf '\nFiles:\n'
    dpkg-deb -c "$deb" | awk '{print $NF}' | grep -v '/$'
}

# ---------- RPM ----------
build_rpm() {
    compute_versions
    has podman || die "install podman (Arch: sudo pacman -S podman)"

    info "Building RPM in Fedora container (${PKG_VERSION})"
    rm -rf build-rpm _CPack_Packages
    find . -maxdepth 1 -name '*.rpm' -delete

    podman run --rm -v "$ROOT:/src:Z" -w /src fedora:41 bash -lc '
        set -euo pipefail
        ./packaging/deps/rpm.sh >/dev/null
        cmake -S . -B build-rpm \
            -DCMAKE_BUILD_TYPE=Release \
            -DBUILD_TESTING=OFF \
            -DCMAKE_INSTALL_PREFIX=/usr
        cmake --build build-rpm -j"$(nproc)"
        cpack --config build-rpm/CPackConfig.cmake -G RPM
    '

    local rpm; rpm="$(find . -maxdepth 1 -name '*.rpm' -print -quit)"
    [[ -n "$rpm" ]] || die "RPM was not produced"
    ok "RPM: $rpm"
}

verify_rpm() {
    local rpm; rpm="$(find . -maxdepth 1 -name '*.rpm' -print -quit)"
    [[ -n "$rpm" ]] || die "no .rpm found"
    has rpm || die "install rpm-tools (Arch: sudo pacman -S rpm-tools)"

    info "Metadata: $rpm"
    rpm -qp --qf '%{NAME} %{VERSION}-%{RELEASE} (%{ARCH})\n' "$rpm"
    printf '\nFiles:\n'
    rpm -qpl "$rpm" 2>/dev/null
    printf '\nRuntime requires:\n'
    rpm -qpR "$rpm" 2>/dev/null \
        | grep -Ev '^(rpmlib|libc\.|libm\.|libgcc|libstdc\+\+|rtld|/usr/bin/sh)'
}

# ---------- Arch ----------
build_arch() {
    compute_versions
    has makepkg || die "install base-devel"
    has updpkgsums || die "install pacman-contrib"
    has rsync || die "install rsync"

    local pkgdir="$ROOT/packaging/arch"
    [[ -f "$pkgdir/PKGBUILD" ]] || die "missing packaging/arch/PKGBUILD"

    info "Building Arch package (${PKG_VERSION})"

    local tarball_name="cdm-${TAG_VERSION}.tar.gz"
    local tarball_path="/tmp/${tarball_name}"
    make_source_tarball "$TAG_VERSION" "$tarball_path" >/dev/null
    cp "$tarball_path" "$pkgdir/$tarball_name"

    # temporarily point PKGBUILD at the local tarball
    local bak="$pkgdir/PKGBUILD.bak"
    cp "$pkgdir/PKGBUILD" "$bak"
    trap 'mv -f "'"$bak"'" "'"$pkgdir"'/PKGBUILD" 2>/dev/null || true' EXIT

    sed -i "s|^source=.*|source=(\"${tarball_name}::file://${tarball_path}\")|" "$pkgdir/PKGBUILD"
    sed -i "s|^pkgver=.*|pkgver=$(release_version)|"                      "$pkgdir/PKGBUILD"
    sed -i "s|^pkgrel=.*|pkgrel=1|"                                       "$pkgdir/PKGBUILD"

    ( cd "$pkgdir" \
      && rm -rf src pkg \
      && rm -f ./*.pkg.tar.zst \
      && updpkgsums \
      && makepkg -f )

    local zst; zst="$(find "$pkgdir" -maxdepth 1 -name '*.pkg.tar.zst' ! -name '*-debug-*' -print -quit)"
    [[ -n "$zst" ]] || die "Arch package was not produced"
    ok "Arch: $zst"
}

verify_arch() {
    local pkgdir="$ROOT/packaging/arch"
    local zst
    zst="$(find "$pkgdir" -maxdepth 1 -name '*.pkg.tar.zst' ! -name '*-debug-*' -print -quit)"
    [[ -n "$zst" ]] || die "no arch package found"

    info "Metadata: $zst"
    pacman -Qpi "$zst"
    printf '\nFiles:\n'
    pacman -Qpl "$zst"
    printf '\nnamcap:\n'
    if has namcap; then namcap "$zst" || true; else warn "namcap not installed"; fi
}

# ---------- pipelines ----------
build_all() { build_deb; build_rpm; build_arch; }
verify_all() {
    [[ -n "$(find . -maxdepth 1 -name '*.deb' -print -quit)" ]] && verify_deb || warn "no .deb"
    [[ -n "$(find . -maxdepth 1 -name '*.rpm' -print -quit)" ]] && verify_rpm || warn "no .rpm"
    verify_arch
}

run_tests() {
    info "Configuring Debug build with tests"
    cmake -S . -B build -DBUILD_TESTING=ON -DCMAKE_BUILD_TYPE=Debug
    cmake --build build -j"$(nproc)"
    info "Running ctest"
    ctest --test-dir build --output-on-failure
}

# ---------- version management ----------
bump_version() {
    local what="${1:-}"
    case "$what" in
        rc)
            local n="${2:-}" cur; cur="$(release_rc)"
            [[ -z "$n" ]] && n=$((cur + 1))
            sed -i "s|^rc[[:space:]]*=.*|rc = ${n}|"      .release.toml
            sed -i "s|^channel[[:space:]]*=.*|channel = \"rc\"|" .release.toml
            ok "rc -> $n"
            ;;
        rcreset)
            sed -i "s|^rc[[:space:]]*=.*|rc = 1|" .release.toml
            sed -i "s|^channel[[:space:]]*=.*|channel = \"rc\"|" .release.toml
            ok "rc reset to 1, channel=rc"
            ;;
        stable)
            sed -i "s|^channel[[:space:]]*=.*|channel = \"stable\"|" .release.toml
            ok "channel=stable"
            ;;
        major|minor|patch)
            local v a b c
            v="$(release_version)"
            IFS=. read -r a b c <<< "$v"
            case "$what" in
                major) a=$((a+1)); b=0; c=0 ;;
                minor) b=$((b+1)); c=0 ;;
                patch) c=$((c+1)) ;;
            esac
            sed -i "s|^version[[:space:]]*=.*|version = \"${a}.${b}.${c}\"|" .release.toml
            sed -i "s|^rc[[:space:]]*=.*|rc = 1|"                            .release.toml
            sed -i "s|^channel[[:space:]]*=.*|channel = \"rc\"|"              .release.toml
            ok "version -> ${a}.${b}.${c}-rc1"
            ;;
        *)
            die "usage: $0 bump rc [N] | rcreset | stable | patch | minor | major"
            ;;
    esac
    show_version
}

# ---------- release ----------
github_repo_url() {
    local remote
    remote="$(git config --get remote.origin.url || true)"
    [[ -n "$remote" ]] || die "no origin remote configured"
    printf '%s' "$remote" \
        | sed -E 's|^git@([^:]+):(.*)\.git$|https://\1/\2|' \
        | sed -E 's|\.git$||'
}

open_release() {
    compute_versions
    local url; url="$(github_repo_url)/releases/tag/${RELEASE_TAG}"
    info "Release URL: $url"
    if has xdg-open; then xdg-open "$url" >/dev/null 2>&1 &
    elif has open;  then open "$url"
    else printf '%s\n' "$url"
    fi
}

make_tag() {
    compute_versions
    git rev-parse --abbrev-ref HEAD | grep -qx main \
        || die "must be on main to tag"
    git diff --quiet && git diff --cached --quiet \
        || die "working tree is dirty; commit first"
    [[ -z "$(git tag -l "$RELEASE_TAG")" ]] \
        || die "tag $RELEASE_TAG already exists"
    info "Creating tag $RELEASE_TAG"
    git tag -a "$RELEASE_TAG" -m "Release $RELEASE_TAG"
    git push origin "$RELEASE_TAG"
    ok "tag pushed — GitHub Actions will build and publish"
    open_release
}

# ---------- housekeeping ----------
clean_all() {
    info "Cleaning build trees and artifacts"
    rm -rf build build-asan build-deb build-rpm _CPack_Packages
    rm -rf packaging/arch/src packaging/arch/pkg packaging/arch/PKGBUILD.bak
    find . -maxdepth 1 -name '*.deb' -delete
    find . -maxdepth 1 -name '*.rpm' -delete
    find . -maxdepth 1 -name '*.pkg.tar.zst' -delete
    find . -maxdepth 1 -name 'SHA256SUMS*' -delete
    find packaging/arch -maxdepth 1 -name '*.pkg.tar.zst' -delete
    find packaging/arch -maxdepth 1 -name 'cdm-*.tar.gz' -delete
    rm -f /tmp/cdm-*.tar.gz
    ok "clean"
}

# ---------- doctor ----------
doctor() {
    compute_versions
    local fail=0

    info "Release version"
    printf '  channel:      %s\n' "$(release_channel)"
    printf '  base:         %s\n' "$(release_version)"
    printf '  rc:           %s\n' "$(release_rc)"
    printf '  tag:          %s\n' "$RELEASE_TAG"
    printf '  pkg version:  %s\n' "$PKG_VERSION"

    info "Required tools"
    local t
    for t in git cmake cpack rsync; do
        if has "$t"; then ok "  $t"; else warn "  missing: $t"; fail=1; fi
    done
    for t in makepkg updpkgsums; do
        if has "$t"; then ok "  $t"; else warn "  missing: $t (needed for: cdm arch)"; fi
    done
    if has podman; then ok "  podman"; else warn "  missing: podman (needed for: cdm rpm)"; fi
    if has dpkg-deb; then ok "  dpkg-deb"; else warn "  missing: dpkg-deb (needed for: cdm deb)"; fi
    if has rpm; then ok "  rpm"; else warn "  missing: rpm (needed for: cdm verify-rpm)"; fi
    if has namcap; then ok "  namcap"; else warn "  missing: namcap (optional)"; fi

    info "Dependency scripts"
    local kind f
    for kind in deb rpm arch; do
        f="$ROOT/packaging/deps/${kind}.sh"
        if [[ ! -f "$f" ]]; then
            warn "  missing: packaging/deps/${kind}.sh"
            fail=1
        elif [[ ! -x "$f" ]]; then
            warn "  not executable: packaging/deps/${kind}.sh"
            fail=1
        else
            ok "  packaging/deps/${kind}.sh"
        fi
    done

    info "Workflows"
    local wf
    for wf in release-deb release-rpm; do
        f="$ROOT/.github/workflows/${wf}.yml"
        if [[ ! -f "$f" ]]; then
            warn "  missing: .github/workflows/${wf}.yml"
            fail=1
        elif grep -q 'packaging/deps/' "$f"; then
            ok "  ${wf}.yml references packaging/deps/"
        else
            warn "  ${wf}.yml does not reference packaging/deps/"
            fail=1
        fi
    done

    info "PKGBUILD cross-check"
    local pkg="$ROOT/packaging/arch/PKGBUILD"
    if [[ -f "$pkg" ]]; then
        if grep -q "^sha256sums=.*SKIP" "$pkg"; then
            warn "  sha256sums=('SKIP') — regenerate with updpkgsums before publishing"
        fi
        if grep -q 'file:///' "$pkg"; then
            warn "  source= points at a local file — restore GitHub URL before commit"
        fi
        local drift=""
        while IFS= read -r name; do
            [[ -z "$name" ]] && continue
            if ! grep -qw -- "$name" "$ROOT/packaging/deps/arch.sh" 2>/dev/null; then
                drift="${drift}  ${name}"$'\n'
            fi
        done < <(sed -n '/^depends=(/,/^)/p;/^makedepends=(/,/^)/p' "$pkg" \
                 | grep -oE "'[^']+'" | tr -d "'")
        if [[ -n "$drift" ]]; then
            info "  PKGBUILD entries not directly listed in packaging/deps/arch.sh (may be implicit):"
            printf '%s' "$drift"
        else
            ok "  PKGBUILD deps covered by packaging/deps/arch.sh"
        fi
    else
        warn "  missing: packaging/arch/PKGBUILD"
        fail=1
    fi

    if (( fail )); then
        die "doctor found blocking issues"
    fi
    ok "all checks passed"
}

# ---------- dispatcher ----------
usage() {
    cat <<EOF
cdm — build & release toolkit

Usage: cdm <command> [args]

Version
  version                 show resolved versions from .release.toml
  bump rc [N]             bump rc to N (or +1)
  bump rcreset            set rc=1
  bump stable             switch channel to stable
  bump patch|minor|major  bump base version, switch to rc

Build
  tarball                 write source tarball to /tmp/cdm-<ver>.tar.gz
  deb                     build DEB on host
  rpm                     build RPM in Fedora container
  arch                    build Arch package via makepkg
  all                     build deb + rpm + arch

Verify
  verify-deb              inspect the DEB metadata
  verify-rpm              inspect the RPM metadata
  verify-arch             inspect the Arch package metadata
  verify                  verify everything present

Test
  test                    configure + build + ctest

Utility
  doctor                  check tools, deps scripts, workflows, PKGBUILD
  deps deb|rpm|arch       print build dependency list
  clean                   remove all build artifacts
  open-release            open the GitHub release page for the current tag
  tag                     create and push the current tag (triggers CI)
  help                    this message
EOF
}

cmd="${1:-help}"; shift || true
case "$cmd" in
    version)        show_version ;;
    bump)           bump_version "$@" ;;
    tarball)        compute_versions; make_source_tarball "$TAG_VERSION" ;;
    deb)            build_deb ;;
    rpm)            build_rpm ;;
    arch)           build_arch ;;
    all)            build_all ;;
    verify-deb)     verify_deb ;;
    verify-rpm)     verify_rpm ;;
    verify-arch)    verify_arch ;;
    verify)         verify_all ;;
    test)           run_tests ;;
    doctor)         doctor ;;
    deps)           show_deps "$@" ;;
    clean)          clean_all ;;
    open-release)   open_release ;;
    tag)            make_tag ;;
    help|-h|--help) usage ;;
    *)              die "unknown command: $cmd (try 'cdm help')" ;;
esac
