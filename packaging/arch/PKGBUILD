# Maintainer: Opu Hossain <opuhossain@tutamail.com>
pkgname=cdm
pkgver=0.2.0rc1
pkgrel=1
pkgdesc="Core Download Manager with optional browser integration"
arch=('x86_64' 'aarch64')
url="https://github.com/opu-hossain/cdm"
license=('MIT')
depends=(
  'libnotify'
  'sdl2'
  'libepoxy'
  'mesa'
  'curl'
  'sqlite'
  'glibc'
  'gcc-libs'
)
makedepends=(
  'cmake'
  'python'
  'git'
  'pkgconf'
  'libnotify'
  'sdl2'
  'libepoxy'
  'mesa'
)
backup=('etc/xdg/autostart/cdm-daemon.desktop')
_upstream_version="${pkgver/rc/-rc}"
source=("$pkgname-$pkgver.tar.gz::https://github.com/opu-hossain/cdm/archive/refs/tags/v$_upstream_version.tar.gz")
sha256sums=('SKIP')

build() {
  cd "$srcdir/cdm-$_upstream_version"
  cmake -S . -B build \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DBUILD_TESTING=OFF
  cmake --build build -j"$(nproc)"
}

package() {
  cd "$srcdir/cdm-$_upstream_version"
  DESTDIR="$pkgdir" cmake --install build
}
